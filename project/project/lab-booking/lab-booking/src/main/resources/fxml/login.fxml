<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="12" prefWidth="420" prefHeight="380"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mbstu.labbooking.controller.LoginController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

    <Label text="ICT Lab Resource Booking">
        <font><Font name="System Bold" size="20"/></font>
    </Label>
    <Label text="MBSTU - Dept. of ICT" style="-fx-text-fill: #666;"/>

    <Separator/>

    <TextField fx:id="emailField" promptText="Email"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>

    <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>

    <Button text="Login" onAction="#handleLogin" defaultButton="true"
            maxWidth="Infinity" style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>
    <Hyperlink text="New student? Register here" onAction="#goToRegister"/>
</VBox>
